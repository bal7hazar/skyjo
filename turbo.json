{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "preview": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false
    },
    "lint": {},
    "lint:check": {},
    "format": {},
    "format:check": {}
  }
}
